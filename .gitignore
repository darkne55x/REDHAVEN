# ============================================================================
# REDHAVEN .gitignore
# ============================================================================

# Scan Results
results/
*.txt
*.json
!CHANGELOG.json
!package.json
*.log

# API Keys & Secrets
*tokens.txt
*token.txt
provider-config.yaml
.env
secrets/
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Docker
.dockerignore

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
.temp/
tmp/
*.tmp
*.bak
*.old

# Nuclei
nuclei-templates/.git/

# Test outputs
test_results/
screenshots/
gowitness.db
gowitness.sqlite3

# CI/CD
.github/workflows/*.log
